{
    "tasks": {
        "dev": "deno run -A --env-file=.env.development npm:vite",
        // Component test pages (dev-pages/) with a fake login and backend, at http://localhost:3001
        "dev:pages": "deno run -A --env-file=.env.development npm:vite --config vite.dev-pages.config.ts",
        // Disabled: no Firebase environment for production yet (only .env.development exists), so a build would fail at startup
        // with auth/invalid-api-key. Re-enable once production env config is in place.
        // "build": "deno run -A npm:vite build",
        "fmt": "deno fmt",
        "fmt:check": "deno fmt --check",
        "typecheck": "deno check src/ dev-pages/ vite.config.ts vite.dev-pages.config.ts",
        "lint": "deno lint"
    },
    "imports": {
        "@deno/vite-plugin": "npm:@deno/vite-plugin@^2.0.4",
        "@emotion/react": "npm:@emotion/react@^11.14.0",
        "@emotion/styled": "npm:@emotion/styled@^11.14.1",
        "@hookform/resolvers": "npm:@hookform/resolvers@^5.9.1",
        "@mui/icons-material": "npm:@mui/icons-material@^9.4.0",
        "@mui/material": "npm:@mui/material@^9.4.0",
        "@types/node": "npm:@types/node@^24",
        "@types/react": "npm:@types/react@^19.3.0",
        "@types/react-dom": "npm:@types/react-dom@^19.3.0",
        "@vitejs/plugin-react": "npm:@vitejs/plugin-react@^6.1.1",
        "firebase": "npm:firebase@^12.19.0",
        "react": "npm:react@^19.3.0",
        "react-dom": "npm:react-dom@^19.3.0",
        "react-firebase-hooks": "npm:react-firebase-hooks@^5.1.1",
        "react-hook-form": "npm:react-hook-form@^7.89.0",
        "react-router": "npm:react-router@^8.4.0",
        "react-stomp-hooks": "npm:react-stomp-hooks@^3.0.1",
        "react-toastify": "npm:react-toastify@^11.1.0",
        "vite": "npm:vite@^8.3.1",
        "zod": "npm:zod@^4.6.5"
    },
    "compilerOptions": {
        "types": ["react", "react-dom", "@types/react", "./src/vite-env.d.ts"],
        "lib": ["dom", "dom.iterable", "deno.ns"],
        "jsx": "react-jsx",
        "jsxImportSource": "react"
    },
    "nodeModulesDir": "auto",
    "fmt": {
        "semiColons": false,
        "indentWidth": 4,
        "lineWidth": 160
    },
    "exclude": [
        "src/.vite/",
        "dev-pages/.vite/",
        "src/dist/"
    ]
}
